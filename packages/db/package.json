{
  "name": "@one/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && rm -rf dist/generated && cp -R generated dist/generated",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo no-op",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@one/config": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
