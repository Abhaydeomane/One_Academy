# Server-side base URL for API calls made from Server Components.
API_BASE_URL=http://localhost:4000
# Canonical site origin, used for metadata, sitemap and robots.
SITE_URL=http://localhost:3000
# Shared with the API (32+ characters, same value as its REVALIDATE_SECRET).
# Unset, /api/revalidate refuses every request and pages refresh on their TTL.
# REVALIDATE_SECRET=
