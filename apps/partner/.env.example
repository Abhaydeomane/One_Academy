API_BASE_URL=http://localhost:4000

# Replace both with real test keys from the Clerk dashboard before signing in.
# The placeholder publishable key below is well-formed, so `next build`
# succeeds, but authentication will not work until it is replaced.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
