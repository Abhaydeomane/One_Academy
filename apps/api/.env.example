NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://one_academy:local_dev_only@localhost:5432/one_academy_dev
# Obtain test keys from the Clerk dashboard. Protected routes fail without them.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The web app's revalidation endpoint and a shared secret (32+ characters, the
# same value as REVALIDATE_SECRET in apps/web). Leave both unset to rely on the
# 300-second cache TTL.
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=
# Media storage (ADR 0019). fs writes to MEDIA_FS_ROOT and serves it at /media.
STORAGE_DRIVER=fs
MEDIA_FS_ROOT=.media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# For STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO):
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
