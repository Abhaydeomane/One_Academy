{
  "name": "@one/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@clerk/express": "catalog:",
    "@one/db": "workspace:*",
    "@one/shared": "workspace:*",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "multer": "catalog:",
    "pino": "catalog:",
    "sharp": "catalog:",
    "svix": "2.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@one/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/express-serve-static-core": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
